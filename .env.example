# =============================================================================
# Provenance — environment variable reference
# Copy this file to .env and fill in values for local development.
# Production values live ONLY in AWS Secrets Manager — never commit .env.
# =============================================================================

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me-local-dev-only

# ── Database (Docker Compose default) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://provenance:provenance@localhost:5432/provenance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis (Docker Compose default) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth — Clerk (https://dashboard.clerk.com) ────────────────────────────────
# Create a new application in Clerk and copy keys from the API Keys page.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=                 # safe to expose — prefixed NEXT_PUBLIC_ on frontend
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Frontend Clerk keys (exposed to browser — only publishable key here)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── LLM — Anthropic (https://console.anthropic.com) ──────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                        # fallback route only

# Model routing — change here, not in code
LLM_MODEL_EXTRACTION=claude-3-5-sonnet-20241022
LLM_MODEL_CLASSIFICATION=claude-3-haiku-20240307
LLM_MODEL_EXPLANATION=claude-3-5-sonnet-20241022
LLM_MODEL_INVESTIGATION=claude-3-5-sonnet-20241022
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
DEFAULT_MONTHLY_TOKEN_BUDGET=5000000

# ── Embeddings — Voyage (https://dash.voyageai.com) ──────────────────────────
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

# ── LLM observability — Langfuse (https://cloud.langfuse.com) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── External data sources ──────────────────────────────────────────────────────
# data.gov.in — register free at https://data.gov.in
DATA_GOV_IN_API_KEY=

# GDELT — no key, but User-Agent is required
GDELT_USER_AGENT=Provenance/1.0 (supply-chain-risk; contact@provenance.app)
GDELT_MIN_REQUEST_INTERVAL_SECONDS=6

# OFAC, Federal Register, GLEIF — no auth required
OFAC_SLS_BASE_URL=https://sanctionslistservice.ofac.treas.gov
FEDERAL_REGISTER_BASE_URL=https://www.federalregister.gov/api/v1
GLEIF_BASE_URL=https://api.gleif.org/api/v1

# EU Sanctions — free token from https://www.eustsanctions.eu/
EU_SANCTIONS_TOKEN=

# EUR-Lex web service — register at https://eur-lex.europa.eu
EURLEX_WS_USERNAME=
EURLEX_WS_PASSWORD=

# Price intelligence (Phase 14b)
# FRED — register free at https://fredaccount.stlouisfed.org
FRED_API_KEY=
ECB_FX_BASE_URL=https://data-api.ecb.europa.eu
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2

# OPENSANCTIONS_API_KEY=               # Phase 2 ONLY — commercial licence required

# ── Storage — AWS (LocalStack for local dev) ──────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test                 # LocalStack accepts any value
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566 # LocalStack endpoint

S3_BUCKET_DOCUMENTS=provenance-documents-local
S3_BUCKET_RAW_PAYLOADS=provenance-raw-payloads-local
S3_BUCKET_EXPORTS=provenance-exports-local

# ── Email (MailHog for local dev) ─────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@provenance.app
# MailHog SMTP: localhost:1025, web UI: localhost:8025

# ── Chat integrations ─────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# ── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=provenance-api

# ── Security ───────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_USER_HOUR=1000
MAX_UPLOAD_SIZE_MB=25
CLAMAV_HOST=
